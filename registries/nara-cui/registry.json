{
  "registry_info": {
    "title": "CUI Registry",
    "publisher": "National Archives and Records Administration (NARA)",
    "authority": ["Executive Order 13556", "32 CFR Part 2002"],
    "url": "https://www.archives.gov/cui",
    "description": "The Government-wide online repository for Federal-level guidance regarding CUI policy and practice. Established under Executive Order 13556 and implemented via 32 CFR Part 2002. NARA serves as the CUI Executive Agent, with the Information Security Oversight Office (ISOO) handling operational oversight.",
    "cui_types": {
      "basic": "The subset of CUI for which the authorizing law, regulation, or Government-wide policy does not set out specific handling or dissemination controls. Agencies apply uniform controls from Executive Order 13556 and 32 CFR Part 2002. The controls for all CUI Basic categories and subcategories are the same.",
      "specified": "The subset of CUI in which the authorizing law, regulation, or Government-wide policy contains specific handling controls that it requires or permits agencies to use that differ from those for CUI Basic. The controls for CUI Specified categories can differ from CUI Basic controls and from each other. CUI Basic controls apply to those aspects of CUI Specified where the authorizing laws do not provide specific guidance."
    },
    "sources": {
      "category_list": {
        "title": "CUI Registry: Category List",
        "url": "https://www.archives.gov/cui/registry/category-list",
        "last_reviewed": "2025-03-06",
        "date_accessed": "2026-02-19",
        "citation_mla": "\"CUI Registry: Category List.\" National Archives, National Archives and Records Administration, 6 Mar. 2025, www.archives.gov/cui/registry/category-list. Accessed 19 Feb. 2026."
      },
      "category_marking_list": {
        "title": "CUI Category Marking List",
        "url": "https://www.archives.gov/cui/registry/category-marking-list",
        "last_reviewed": "2024-04-09",
        "date_accessed": "2026-02-19",
        "citation_mla": "\"CUI Category Marking List.\" National Archives, National Archives and Records Administration, 9 Apr. 2024, www.archives.gov/cui/registry/category-marking-list. Accessed 19 Feb. 2026."
      }
    }
  },
