  "requirements": [
    {
      "id": "REQ-1.1",
      "category": "Roles and Responsibilities",
      "priority": "Mandatory",
      "applicability": "organizational",
      "description": "The NASA Administrator SHALL establish and maintain an agency-wide CUI program consistent with EO 13556 and 32 CFR Part 2002.",
      "standard": "EO-13556",
      "trace": "Chapter 1, Administrator Responsibilities",
      "verification": "Analysis"
    },
    {
      "id": "REQ-1.2",
      "category": "Roles and Responsibilities",
      "priority": "Mandatory",
      "applicability": "organizational",
      "description": "The NASA Chief Information Officer/Senior Agency Official (CIO/SAO) SHALL oversee implementation of the CUI program across the agency.",
      "standard": "32-CFR-2002",
      "trace": "Chapter 1, CIO/SAO Responsibilities",
      "verification": "Analysis"
    },
    {
      "id": "REQ-1.3",
      "category": "Roles and Responsibilities",
      "priority": "Mandatory",
      "applicability": "organizational",
      "description": "The CUI Program Manager SHALL manage day-to-day CUI program operations and serve as the primary point of contact for CUI matters.",
      "standard": "32-CFR-2002",
      "trace": "Chapter 1, CUI PM Responsibilities",
      "verification": "Analysis"
    },
    {
      "id": "REQ-1.4",
      "category": "Roles and Responsibilities",
      "priority": "Mandatory",
      "applicability": "organizational",
      "description": "Center Directors SHALL ensure CUI program compliance at their respective Centers.",
      "standard": "32-CFR-2002",
      "trace": "Chapter 1, Center Director Responsibilities",
      "verification": "Analysis"
    },
    {
      "id": "REQ-1.5",
      "category": "Roles and Responsibilities",
      "priority": "Mandatory",
      "applicability": "organizational",
      "description": "Center Chief Information Officers SHALL implement IT controls for CUI within Center information systems.",
      "standard": "NIST-SP-800-53",
      "trace": "Chapter 1, Center CIO Responsibilities",
      "verification": "Analysis"
    },
    {
      "id": "REQ-1.6",
      "category": "Roles and Responsibilities",
      "priority": "Mandatory",
      "applicability": "organizational",
      "description": "Contracting Officers SHALL include CUI handling requirements in contracts and agreements involving CUI.",
      "standard": "32-CFR-2002",
      "trace": "Chapter 1, Contracting Officer Responsibilities",
      "verification": "Analysis"
    },
    {
      "id": "REQ-1.7",
      "category": "Roles and Responsibilities",
      "priority": "Mandatory",
      "applicability": "organizational",
      "description": "Contracting Officer Representatives (CORs) SHALL monitor contractor compliance with CUI handling requirements.",
      "standard": "32-CFR-2002",
      "trace": "Chapter 1, COR Responsibilities",
      "verification": "Analysis"
    },
    {
      "id": "REQ-1.8",
      "category": "Roles and Responsibilities",
      "priority": "Mandatory",
      "applicability": "organizational",
      "description": "Supervisors SHALL ensure all personnel under their authority are aware of CUI requirements and complete required training.",
      "standard": "32-CFR-2002",
      "trace": "Chapter 1, Supervisor Responsibilities",
      "verification": "Analysis"
    },
    {
      "id": "REQ-1.9",
      "category": "Roles and Responsibilities",
      "priority": "Mandatory",
      "applicability": "organizational",
      "description": "All NASA personnel and contractors SHALL safeguard CUI in their possession and report suspected unauthorized disclosures.",
      "standard": "32-CFR-2002",
      "trace": "Chapter 1, All Personnel Responsibilities",
      "verification": "Analysis"
    },
    {
      "id": "REQ-1.10",
      "category": "Roles and Responsibilities",
      "priority": "Mandatory",
      "applicability": "organizational",
      "description": "Non-executive branch entities receiving CUI SHALL handle it in accordance with the provisions of applicable agreements (MOUs, contracts, grants).",
      "standard": "32-CFR-2002",
      "trace": "Chapter 1, Non-Executive Branch Responsibilities",
      "verification": "Analysis"
    },
    {
      "id": "REQ-2.1.1",
      "category": "General CUI Management",
      "priority": "Mandatory",
      "applicability": "organizational",
      "description": "CUI categories and subcategories SHALL be drawn from the NARA CUI Registry.",
      "standard": "NARA-CUI-Registry",
      "trace": "\u00a72.1 General",
      "verification": "Inspection"
    },
    {
      "id": "REQ-2.1.2",
      "category": "General CUI Management",
      "priority": "Mandatory",
      "applicability": "informational",
      "description": "Authorized holders of CUI SHALL be responsible for knowing what CUI they possess, how to protect it, and whom to contact regarding questions about CUI.",
      "standard": "32-CFR-2002",
      "trace": "\u00a72.1 General",
      "verification": "Analysis"
    },
    {
      "id": "REQ-2.1.3",
      "category": "General CUI Management",
      "priority": "Mandatory",
      "applicability": "informational",
      "description": "CUI Basic SHALL be handled according to the uniform set of controls in 32 CFR Part 2002. CUI Specified SHALL be handled according to the controls required by the authorizing law, regulation, or government-wide policy.",
      "standard": "32-CFR-2002",
      "trace": "\u00a72.1 General \u2014 CUI Basic vs CUI Specified",
      "verification": "Analysis"
    },
    {
      "id": "REQ-2.2.1",
      "category": "Marking",
      "priority": "Mandatory",
      "applicability": "technical",
      "description": "All CUI documents SHALL include a CUI banner marking at the top of each page.",
      "standard": "32-CFR-2002",
      "trace": "\u00a72.2 Marking of CUI",
      "verification": "Inspection"
    },
    {
      "id": "REQ-2.2.2",
      "category": "Marking",
      "priority": "Mandatory",
      "applicability": "technical",
      "description": "The CUI banner marking SHALL include the CUI designation indicator (e.g., CUI or CONTROLLED).",
      "standard": "32-CFR-2002",
      "trace": "\u00a72.2 Marking \u2014 Designation Indicator",
      "verification": "Inspection"
    },
    {
      "id": "REQ-2.2.3",
      "category": "Marking",
      "priority": "Mandatory",
      "applicability": "technical",
      "description": "CUI Specified documents SHALL include the specific CUI category or subcategory marking (e.g., CUI//SP-CTI, CUI//SP-EXPT).",
      "standard": "32-CFR-2002",
      "trace": "\u00a72.2 Marking \u2014 Category/Subcategory",
      "verification": "Inspection"
    },
    {
      "id": "REQ-2.2.4",
      "category": "Marking",
      "priority": "Mandatory",
      "applicability": "technical",
      "description": "CUI markings SHALL include the name or abbreviation of the designating agency or organization.",
      "standard": "32-CFR-2002",
      "trace": "\u00a72.2 Marking \u2014 Agency Indicator",
      "verification": "Inspection"
    },
    {
      "id": "REQ-2.2.5",
      "category": "Marking",
      "priority": "Recommended",
      "applicability": "technical",
      "description": "CUI markings SHOULD include limited dissemination control markings where applicable (e.g., NOFORN, FEDCON, NOCON).",
      "standard": "32-CFR-2002",
      "trace": "\u00a72.2 Marking \u2014 Dissemination Controls",
      "verification": "Inspection"
    },
    {
      "id": "REQ-2.2.6",
      "category": "Marking",
      "priority": "Recommended",
      "applicability": "technical",
      "description": "CUI banner markings SHOULD include a point of contact for questions about the CUI designation.",
      "standard": "32-CFR-2002",
      "trace": "\u00a72.2 Marking \u2014 Point of Contact",
      "verification": "Inspection"
    },
    {
      "id": "REQ-2.3.1",
      "category": "Portion Marking",
      "priority": "Optional",
      "applicability": "technical",
      "description": "Portion marking of CUI documents MAY be used at NASA but is not required unless mandated by a CUI Specified authority.",
      "standard": "32-CFR-2002",
      "trace": "\u00a72.3 Portion Marking",
      "verification": "Analysis"
    },
    {
      "id": "REQ-2.3.2",
      "category": "Portion Marking",
      "priority": "Mandatory",
      "applicability": "technical",
      "description": "If portion marking is used, each portion containing CUI SHALL be marked with the applicable CUI designation.",
      "standard": "32-CFR-2002",
      "trace": "\u00a72.3 Portion Marking",
      "verification": "Inspection"
    },
    {
      "id": "REQ-2.4.1",
      "category": "Commingling",
      "priority": "Mandatory",
      "applicability": "informational",
      "description": "When CUI is commingled with classified information, the most restrictive handling requirements SHALL apply to the entire document.",
      "standard": "32-CFR-2002",
      "trace": "\u00a72.4 Commingling",
      "verification": "Analysis"
    },
    {
      "id": "REQ-2.4.2",
      "category": "Commingling",
      "priority": "Recommended",
      "applicability": "informational",
      "description": "CUI SHOULD be separated from classified national security information where feasible to facilitate appropriate handling.",
      "standard": "32-CFR-2002",
      "trace": "\u00a72.4 Commingling",
      "verification": "Analysis"
    },
    {
      "id": "REQ-2.5.1",
      "category": "Cover Sheets",
      "priority": "Mandatory",
      "applicability": "technical",
      "description": "Standard Form 901 (SF901) CUI cover sheets SHALL be used when required to protect CUI documents from unauthorized visual access.",
      "standard": "32-CFR-2002",
      "trace": "\u00a72.5 CUI Cover Sheets",
      "verification": "Inspection"
    },
    {
      "id": "REQ-2.5.2",
      "category": "Cover Sheets",
      "priority": "Mandatory",
      "applicability": "organizational",
      "description": "Legacy markings (e.g., FOUO, SBU) on existing documents SHALL be honored and protected at the CUI level until the documents are re-marked or decontrolled.",
      "standard": "32-CFR-2002",
      "trace": "\u00a72.5 Legacy Materials",
      "verification": "Analysis"
    },
    {
      "id": "REQ-2.6.1",
      "category": "Working Papers",
      "priority": "Mandatory",
      "applicability": "organizational",
      "description": "Working papers containing CUI SHALL be marked and safeguarded in the same manner as final CUI documents.",
      "standard": "32-CFR-2002",
      "trace": "\u00a72.6 Working Papers",
      "verification": "Analysis"
    },
    {
      "id": "REQ-2.7.1",
      "category": "Supplemental Markings",
      "priority": "Mandatory",
      "applicability": "technical",
      "description": "Supplemental administrative markings (e.g., NOFORN, FEDCON, NOCON) SHALL be applied in accordance with the CUI Registry and dissemination control requirements.",
      "standard": "NARA-CUI-Registry",
      "trace": "\u00a72.7 Supplemental Markings",
      "verification": "Inspection"
    },
    {
      "id": "REQ-2.7.2",
      "category": "Supplemental Markings",
      "priority": "Mandatory",
      "applicability": "technical",
      "description": "Limited dissemination controls SHALL be indicated after the CUI marking, separated by a double slash (e.g., CUI//NOFORN).",
      "standard": "32-CFR-2002",
      "trace": "\u00a72.7 Supplemental Markings \u2014 Format",
      "verification": "Inspection"
    },
    {
      "id": "REQ-2.8.1",
      "category": "Unmarked CUI",
      "priority": "Mandatory",
      "applicability": "organizational",
      "description": "Personnel who receive information they believe to be CUI but is not marked SHALL notify the designating agency or authorized holder.",
      "standard": "32-CFR-2002",
      "trace": "\u00a72.8 Unmarked CUI",
      "verification": "Analysis"
    },
    {
      "id": "REQ-2.8.2",
      "category": "Unmarked CUI",
      "priority": "Mandatory",
      "applicability": "organizational",
      "description": "Suspected CUI that is not marked SHALL be treated as CUI and safeguarded accordingly until the designating agency confirms or denies the CUI status.",
      "standard": "32-CFR-2002",
      "trace": "\u00a72.8 Unmarked CUI",
      "verification": "Analysis"
    },
    {
      "id": "REQ-2.9.1",
      "category": "Sharing and Dissemination",
      "priority": "Mandatory",
      "applicability": "technical",
      "description": "CUI SHALL only be shared with authorized recipients who have a lawful government purpose and a need to know.",
      "standard": "32-CFR-2002",
      "trace": "\u00a72.9 Sharing \u2014 Need to Know",
      "verification": "Inspection"
    },
    {
      "id": "REQ-2.9.2",
      "category": "Sharing and Dissemination",
      "priority": "Mandatory",
      "applicability": "organizational",
      "description": "Sharing CUI with non-executive branch entities SHALL be governed by written agreements (MOUs, contracts, grants) that specify handling requirements.",
      "standard": "32-CFR-2002",
      "trace": "\u00a72.9 Sharing \u2014 Non-Executive Branch",
      "verification": "Analysis"
    },
    {
      "id": "REQ-2.9.3",
      "category": "Sharing and Dissemination",
      "priority": "Mandatory",
      "applicability": "technical",
      "description": "Electronic transmission of CUI SHALL use encryption meeting the requirements of Section 2.13 (Safeguarding).",
      "standard": "NIST-SP-800-171",
      "trace": "\u00a72.9 Sharing \u2014 Electronic Transmission",
      "verification": "Test"
    },
    {
      "id": "REQ-2.9.4",
      "category": "Sharing and Dissemination",
      "priority": "Recommended",
      "applicability": "technical",
      "description": "When sharing CUI electronically, the transmitting system SHOULD include a notice informing the recipient that the information is CUI and subject to safeguarding requirements.",
      "standard": "32-CFR-2002",
      "trace": "\u00a72.9 Sharing \u2014 Recipient Notice",
      "verification": "Inspection"
    },
    {
      "id": "REQ-2.10.1",
      "category": "Disclosure",
      "priority": "Mandatory",
      "applicability": "organizational",
      "description": "CUI disclosure requirements under FOIA, Privacy Act, and other statutes SHALL be followed. CUI status does not override legal requirements to disclose information.",
      "standard": "32-CFR-2002",
      "trace": "\u00a72.10 CUI Disclosure Statutes",
      "verification": "Analysis"
    },
    {
      "id": "REQ-2.11.1",
      "category": "Challenges",
      "priority": "Mandatory",
      "applicability": "organizational",
      "description": "NASA personnel SHALL be permitted to challenge the designation of information as CUI through established processes without fear of retribution.",
      "standard": "32-CFR-2002",
      "trace": "\u00a72.11 Challenges to Designation",
      "verification": "Analysis"
    },
    {
      "id": "REQ-2.11.2",
      "category": "Challenges",
      "priority": "Mandatory",
      "applicability": "organizational",
      "description": "Challenges to CUI designation SHALL be resolved by the designating authority or the CUI PM within a reasonable timeframe.",
      "standard": "32-CFR-2002",
      "trace": "\u00a72.11 Challenges \u2014 Resolution",
      "verification": "Analysis"
    },
    {
      "id": "REQ-2.12.1",
      "category": "Decontrol",
      "priority": "Mandatory",
      "applicability": "organizational",
      "description": "Only authorized holders or the designating agency SHALL decontrol CUI. Decontrol removes safeguarding and dissemination requirements.",
      "standard": "32-CFR-2002",
      "trace": "\u00a72.12 Decontrol of CUI",
      "verification": "Analysis"
    },
    {
      "id": "REQ-2.12.2",
      "category": "Decontrol",
      "priority": "Mandatory",
      "applicability": "technical",
      "description": "When CUI is decontrolled, all CUI markings SHALL be removed or clearly struck through, and recipients SHALL be notified of the change in status.",
      "standard": "32-CFR-2002",
      "trace": "\u00a72.12 Decontrol \u2014 Marking Removal",
      "verification": "Inspection"
    },
    {
      "id": "REQ-2.13.1",
      "category": "Safeguarding",
      "priority": "Mandatory",
      "applicability": "technical",
      "description": "CUI SHALL be protected from unauthorized access, use, or disclosure through physical, technical, and administrative safeguards.",
      "standard": "NIST-SP-800-171",
      "trace": "\u00a72.13 Safeguarding \u2014 General",
      "verification": "Inspection"
    },
    {
      "id": "REQ-2.13.2",
      "category": "Safeguarding",
      "priority": "Mandatory",
      "applicability": "technical",
      "description": "Electronic CUI at rest SHALL be encrypted using FIPS 140-2 validated cryptographic modules.",
      "standard": "FIPS-140-2",
      "trace": "\u00a72.13 Safeguarding \u2014 Encryption at Rest",
      "verification": "Test"
    },
    {
      "id": "REQ-2.13.3",
      "category": "Safeguarding",
      "priority": "Mandatory",
      "applicability": "technical",
      "description": "Electronic CUI in transit SHALL be encrypted using FIPS 140-2 validated cryptographic modules.",
      "standard": "FIPS-140-2",
      "trace": "\u00a72.13 Safeguarding \u2014 Encryption in Transit",
      "verification": "Test"
    },
    {
      "id": "REQ-2.13.4",
      "category": "Safeguarding",
      "priority": "Mandatory",
      "applicability": "technical",
      "description": "Access to CUI SHALL be limited to authorized individuals through access control mechanisms (authentication and authorization).",
      "standard": "NIST-SP-800-171",
      "trace": "\u00a72.13 Safeguarding \u2014 Access Control",
      "verification": "Test"
    },
    {
      "id": "REQ-2.13.5",
      "category": "Safeguarding",
      "priority": "Mandatory",
      "applicability": "organizational",
      "description": "Physical CUI documents SHALL be stored in locked containers or areas with access restricted to authorized personnel when not under direct control of an authorized holder.",
      "standard": "32-CFR-2002",
      "trace": "\u00a72.13 Safeguarding \u2014 Physical Storage",
      "verification": "Inspection"
    },
    {
      "id": "REQ-2.13.6",
      "category": "Safeguarding",
      "priority": "Mandatory",
      "applicability": "technical",
      "description": "Systems processing CUI SHALL implement the security requirements of NIST SP 800-171 (for nonfederal systems) or NIST SP 800-53 (for federal systems).",
      "standard": "NIST-SP-800-171",
      "trace": "\u00a72.13 Safeguarding \u2014 NIST Controls",
      "verification": "Inspection"
    },
    {
      "id": "REQ-2.13.7",
      "category": "Safeguarding",
      "priority": "Recommended",
      "applicability": "technical",
      "description": "CUI data SHOULD be protected from accidental exposure through anonymization or redaction before sharing outside the authorized handling environment.",
      "standard": "NIST-SP-800-171",
      "trace": "\u00a72.13 Safeguarding \u2014 Data Minimization",
      "verification": "Inspection"
    },
    {
      "id": "REQ-2.13.8",
      "category": "Safeguarding",
      "priority": "Mandatory",
      "applicability": "technical",
      "description": "Backups of CUI data SHALL be protected with the same level of safeguarding as the original data.",
      "standard": "NIST-SP-800-171",
      "trace": "\u00a72.13 Safeguarding \u2014 Backup Protection",
      "verification": "Test"
    },
    {
      "id": "REQ-2.14.1",
      "category": "Reproduction",
      "priority": "Mandatory",
      "applicability": "technical",
      "description": "All CUI markings SHALL be maintained on reproductions (copies) of CUI documents.",
      "standard": "32-CFR-2002",
      "trace": "\u00a72.14 Reproduction of CUI",
      "verification": "Inspection"
    },
    {
      "id": "REQ-2.14.2",
      "category": "Reproduction",
      "priority": "Mandatory",
      "applicability": "organizational",
      "description": "Reproductions of CUI SHALL be subject to the same safeguarding requirements as the original document.",
      "standard": "32-CFR-2002",
      "trace": "\u00a72.14 Reproduction \u2014 Same Protections",
      "verification": "Analysis"
    },
    {
      "id": "REQ-2.15.1",
      "category": "Transmission",
      "priority": "Mandatory",
      "applicability": "technical",
      "description": "CUI transmitted electronically SHALL be encrypted using approved methods meeting FIPS 140-2 requirements.",
      "standard": "FIPS-140-2",
      "trace": "\u00a72.15 Transmission \u2014 Electronic",
      "verification": "Test"
    },
    {
      "id": "REQ-2.15.2",
      "category": "Transmission",
      "priority": "Mandatory",
      "applicability": "organizational",
      "description": "CUI shipped via physical mail SHALL be double-wrapped, with the inner wrapper marked with CUI markings and the outer wrapper unmarked.",
      "standard": "32-CFR-2002",
      "trace": "\u00a72.15 Shipping/Mailing \u2014 Physical",
      "verification": "Analysis"
    },
    {
      "id": "REQ-2.15.3",
      "category": "Transmission",
      "priority": "Mandatory",
      "applicability": "organizational",
      "description": "CUI SHALL only be transmitted using approved channels (e.g., encrypted email, secure file transfer, registered mail).",
      "standard": "32-CFR-2002",
      "trace": "\u00a72.15 Transmission \u2014 Approved Channels",
      "verification": "Analysis"
    },
    {
      "id": "REQ-2.15.4",
      "category": "Transmission",
      "priority": "Mandatory",
      "applicability": "technical",
      "description": "Transmittal documents for CUI SHALL include appropriate CUI markings to indicate the presence of CUI in the attached material.",
      "standard": "32-CFR-2002",
      "trace": "\u00a72.16 Transmittal Document Marking",
      "verification": "Inspection"
    },
    {
      "id": "REQ-2.17.1",
      "category": "Destruction",
      "priority": "Mandatory",
      "applicability": "organizational",
      "description": "Paper CUI documents SHALL be destroyed by cross-cut shredding, pulping, or burning to render the information unreadable and irrecoverable.",
      "standard": "32-CFR-2002",
      "trace": "\u00a72.17 Destruction \u2014 Paper",
      "verification": "Analysis"
    },
    {
